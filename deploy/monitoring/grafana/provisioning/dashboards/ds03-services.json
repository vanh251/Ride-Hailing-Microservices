{
  "uid": "ds03-services",
  "title": "DS03 Services",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Service health (1 = up)",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 4 },
      "targets": [{ "expr": "up", "legendFormat": "{{job}}" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "API requests per second",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (job) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{job}}" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "API errors per second (HTTP 5xx)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (job) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))", "legendFormat": "{{job}}" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "API latency P50 / P95 (pricing, payment, notification)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (job, le) (rate(http_server_requests_seconds_bucket[1m])))", "legendFormat": "p50 {{job}}" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_requests_seconds_bucket[1m])))", "legendFormat": "p95 {{job}}" }
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Kafka consumer lag (records waiting)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [{ "expr": "max by (job) (kafka_consumer_fetch_manager_records_lag_max)", "legendFormat": "{{job}}" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Kafka records consumed per second",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (job) (rate(kafka_consumer_fetch_manager_records_consumed_total[1m]))", "legendFormat": "{{job}}" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "CPU usage",
      "gridPos": { "x": 12, "y": 20, "w": 6, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [{ "expr": "process_cpu_usage", "legendFormat": "{{job}}" }]
    },
    {
      "id": 8, "type": "timeseries", "title": "JVM heap used",
      "gridPos": { "x": 18, "y": 20, "w": 6, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{ "expr": "sum by (job) (jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "{{job}}" }]
    }
  ]
}
